# Unity recommended .gitattributes

# Auto detect text files and perform LF normalization
* text=auto

# Force Unix LF for these text formats
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf
*.compute text eol=lf
*.unity text eol=lf merge=unityyamlmerge diff=unity
*.prefab text eol=lf merge=unityyamlmerge diff=unity
*.asset text eol=lf merge=unityyamlmerge diff=unity
*.meta text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial2D text eol=lf merge=unityyamlmerge
*.playable text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.cubemap text eol=lf merge=unityyamlmerge
*.flare text eol=lf merge=unityyamlmerge
*.brush text eol=lf merge=unityyamlmerge
*.guiskin text eol=lf merge=unityyamlmerge
*.fontsettings text eol=lf merge=unityyamlmerge
*.renderTexture text eol=lf merge=unityyamlmerge
*.spriteatlas text eol=lf merge=unityyamlmerge
*.terrainlayer text eol=lf merge=unityyamlmerge
*.asmdef text eol=lf merge=unityyamlmerge
*.asmref text eol=lf merge=unityyamlmerge
*.inputactions text eol=lf

# JSON & config
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary files — tell git not to diff/merge these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tiff binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.a binary
*.apk binary
*.aab binary
*.unitypackage binary

